pón, como él. Después de salir del pueblo y entrar en el bosque, Rio se encuentra con una joven que se derrumbó en su camino... En el momento en que se acerca y la llama, ¡la chica abre los ojos y le clava un cuchillo!","production_code":"","runtime":24,"season_number":1,"show_id":113808,"still_path":"/4W1HYsC7su5RFB1iK9QJoR3JF0e.jpg","vote_average":7.286,"vote_count":7,"crew":[{"job":"Storyboard Artist","department":"Art","credit_id":"628c0ca1209f1812c49b3f05","adult":false,"gender":2,"id":1463439,"known_for_department":"Directing","name":"青木洋一郎","original_name":"青木洋一郎","popularity":0.666,"profile_path":null},{"job":"Key Animation","department":"Visual Effects","credit_id":"63a7db7c0f21c600ca780bd1","adult":false,"gender":1,"id":3195953,"known_for_department":"Visual Effects","name":"Yurie Goto","original_name":"後藤友里絵","popularity":0.6091,"profile_path":null}],"guest_stars":[{"character":"Cosette (voice)","credit_id":"61bf0323d19a33009542c9df","order":509,"adult":false,"gender":1,"id":1647695,"known_for_department":"Acting","name":"Yuuko Iida","original_name":"飯田友子","popularity":1.0791,"profile_path":"/ucJE4iGwH3dLdqYXvHBHbPut2si.jpg"},{"character":"Shopkeeper (voice)","credit_id":"61bf0330a284eb0062e76793","order":510,"adult":false,"gender":2,"id":2376045,"known_for_department":"Acting","name":"Hiromichi Tezuka","original_name":"手塚ヒロミチ","popularity":2.479,"profile_path":"/6fhWdRzlDtzOrxhffLyaoUun8Gy.jpg"},{"character":"Rio's Mother (voice)","credit_id":"61bf020be24b930066cd38cb","order":511,"adult":false,"gender":1,"id":1550514,"known_for_department":"Acting","name":"You Taichi","original_name":"大地葉","popularity":3.4485,"profile_path":"/bt0oOFKknrOG7gNWusq9sc8UOhm.jpg"},{"character":"Stewart Huguenot (voice)","credit_id":"61bf026de24b930042e91457","order":512,"adult":false,"gender":2,"id":1922635,"known_for_department":"Acting","name":"Shunichi Toki","original_name":"土岐隼一","popularity":2.2895,"profile_path":"/3hauO9r1NEzgXxk8d2ed1p5dnxM.jpg"}]},{"air_date":"2021-0