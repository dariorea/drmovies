í comienza una vida tranquila y feliz junto a los aldeanos, incluido su primo Ruri y una niña llamada Sayo. En poco tiempo, la temporada se convierte en otoño y se enteran de que el revisor fiscal llegará pronto para determinar el monto de su tributo anual. Entonces, un día, el hermano mayor de Sayo, Shin, se pelea con hombres del pueblo vecino.","production_code":"","runtime":24,"season_number":1,"show_id":113808,"still_path":"/fzOh9NrM3cIfT13ZzRivFdw0YfQ.jpg","vote_average":7,"vote_count":5,"crew":[{"job":"Storyboard Artist","department":"Art","credit_id":"63209b4d0b7316008a140b8b","adult":false,"gender":2,"id":2383310,"known_for_department":"Directing","name":"Yoshiyuki Kaneko","original_name":"金子祥之","popularity":0.6993,"profile_path":"/i8eTlq1H5qj6gwFvLFpadTTZrYg.jpg"}],"guest_stars":[{"character":"Gon (voice)","credit_id":"61bf047aa6a4c10043aa3b9f","order":516,"adult":false,"gender":2,"id":2734574,"known_for_department":"Acting","name":"Takuya Nakashima","original_name":"中島卓也","popularity":1.0203,"profile_path":"/ArZzFuBKq3KdjtUOsjzkfG4gEHN.jpg"},{"character":"Aide (voice)","credit_id":"61bf04981056110061fec612","order":517,"adult":false,"gender":2,"id":2376045,"known_for_department":"Acting","name":"Hiromichi Tezuka","original_name":"手塚ヒロミチ","popularity":2.479,"profile_path":"/6fhWdRzlDtzOrxhffLyaoUun8Gy.jpg"},{"character":"Ayame (voice)","credit_id":"61bf04b509ed8f001ca56d3f","order":519,"adult":false,"gender":1,"id":1550514,"known_for_department":"Acting","name":"You Taichi","original_name":"大地葉","popularity":3.4485,"profile_path":"/bt0oOFKknrOG7gNWusq9sc8UOhm.jpg"},{"character":"Saga Hayate (voice)","credit_id":"61bf0489873f00001b22d904","order":521,"adult":false,"gender":2,"id":2279389,"known_for_department":"Acting","name":"Chiaki Kobayashi","original_name":"小林千晃","popularity":2.8249,"profile_path":"/o0XZFXc50z28ICUpvfZ1QcTL2Yt.jpg"},{"character":"Ruri (voice)","credit_id":"61bf0432d19a330061d7c02a","order":528,"adult":false,"gender":1,"id":1253404,"known