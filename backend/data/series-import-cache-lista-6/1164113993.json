 tiene claro lo que tienen que hacer: si el virus no les mata, tendrán que hacerlo ellos.","production_code":"","runtime":66,"season_number":7,"show_id":4743,"still_path":"/sIcp4L6Bh8IZecD7ILO862OVpQ5.jpg","vote_average":0,"vote_count":0,"crew":[{"job":"Writer","department":"Writing","credit_id":"60413b4dc525c400566a6bd7","adult":false,"gender":0,"id":1456400,"known_for_department":"Creator","name":"Emilio Díez","original_name":"Emilio Díez","popularity":0.4715,"profile_path":null},{"job":"Writer","department":"Writing","credit_id":"60413a6263aad200223f28ef","adult":false,"gender":2,"id":1456399,"known_for_department":"Crew","name":"Mariano Baselga","original_name":"Mariano Baselga","popularity":0.4463,"profile_path":null},{"job":"Writer","department":"Writing","credit_id":"604bae9466a0d3005a828244","adult":false,"gender":0,"id":1998078,"known_for_department":"Writing","name":"Luis Murillo Arias","original_name":"Luis Murillo Arias","popularity":0.4679,"profile_path":null},{"job":"Writer","department":"Writing","credit_id":"604bacdba35c8e0044dd97d4","adult":false,"gender":2,"id":2504290,"known_for_department":"Writing","name":"Asier Anduenza","original_name":"Asier Anduenza","popularity":0.5576,"profile_path":null},{"job":"Writer","department":"Writing","credit_id":"604bad81982f740058bcb175","adult":false,"gender":0,"id":2504292,"known_for_department":"Writing","name":"Abraham Sastre","original_name":"Abraham Sastre","popularity":0.6534,"profile_path":null},{"job":"Director","department":"Directing","credit_id":"603b9208db70580051f8f0e8","adult":false,"gender":0,"id":1705421,"known_for_department":"Production","name":"Jesús Rodrigo","original_name":"Jesús Rodrigo","popularity":0.5115,"profile_path":null},{"job":"Writer","department":"Writing","credit_id":"603b92e6a2e602208ef2f89e","adult":false,"gender":0,"id":2814070,"known_for_department":"Writing","name":"Carlos García Miranda","original_name":"Carlos García Miranda","popularity":0.6134,"profile_path":"/y95lYpY2R